{
  "name": "claimme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.mjs",
    "format:check": "prettier --check src tests *.json *.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/drei": "^10.7.0",
    "three": "^0.180.0",
    "@xyflow/react": "^12.9.0",
    "motion": "^12.23.0",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0"
  }
}
